rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function issuePath(issueId) {
      return /databases/(default)/documents/issues/$(issueId);
    }
    function validImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // โฟลเดอร์ใช้ issueId (ไม่ใช้ uid) เพื่อไม่ให้ตัวตนผู้แจ้งรั่วผ่านพาธรูปใน issues_feed
    // อัปโหลดได้ตอนเรื่องยังไม่ถูกสร้าง (ไคลเอนต์สร้าง issueId ล่วงหน้า) หรือเป็นเจ้าของเรื่องเท่านั้น
    match /reports/{issueId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validImage()
        && (!firestore.exists(issuePath(issueId))
            || firestore.get(issuePath(issueId)).data.reporterId == request.auth.uid);
    }
    match /reopens/{issueId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validImage()
        && firestore.get(issuePath(issueId)).data.reporterId == request.auth.uid;
    }
    match /resolutions/{issueId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.get('admin', false) == true && validImage();
    }
  }
}
