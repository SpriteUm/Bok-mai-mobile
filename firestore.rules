rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
    }

    match /categories/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /issues/{issueId} {
      allow read: if isOwner(resource.data.reporterId) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterId', 'categoryCode', 'title', 'description', 'urgency', 'status',
          'location', 'geohash', 'addressText', 'reportCount', 'images',
          'createdAt', 'updatedAt'])
        && request.resource.data.reporterId == request.auth.uid
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.categoryCode))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.urgency in ['low', 'medium', 'high']
        && request.resource.data.status == 'pending'
        && request.resource.data.reportCount == 1
        && request.resource.data.location is latlng
        && request.resource.data.geohash is string
        && request.resource.data.images is list && request.resource.data.images.size() <= 5
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;

      match /updates/{updateId} {
        allow read: if isAdmin() || isOwner(
          get(/databases/$(database)/documents/issues/$(issueId)).data.reporterId);
        allow write: if false;
      }
    }

    match /issues_feed/{issueId} {
      allow read: if signedIn();
      allow write: if false;
      match /followers/{uid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /feedback/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      // ให้คะแนนได้เฉพาะเจ้าของเรื่องที่ resolved แล้ว
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
          ['issueId', 'userId', 'rating', 'tags', 'comment', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/issues/$(request.resource.data.issueId)).data.reporterId == request.auth.uid
        && get(/databases/$(database)/documents/issues/$(request.resource.data.issueId)).data.status == 'resolved'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
